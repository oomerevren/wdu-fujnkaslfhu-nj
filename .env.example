# =============================================================================
# PentestAI — Environment Configuration Example
# =============================================================================
# KULLANIM: Bu dosyayı .env olarak kopyalayın ve değerleri doldurun.
#
#                   ⚠️  PRODUCTION UYARISI  ⚠️
#  • JWT_SECRET_KEY: En az 64 karakterli, rastgele üretilmiş bir anahtar kullanın
#  • STRIPE_*      : Production API key'lerinizi asla buraya yazmayın
#  • SMTP_*        : Production'da gerçek SMTP credentials kullanın
#  • FRONTEND_URL  : Production domain'inizi yazın
#  • DEBUG         : Production'da KESİNLİKLE False yapın
#  • OPENAI_API_KEY: Production key'inizi asla paylaşmayın, rotasyona tabi tutun
#  • NEO4J_*       : Production'da güçlü parola ve TLS kullanın
#  • OTEL_TOKEN    : Observability token'ınızı gizli tutun
#  • SENTRY_DSN    : DSN bir sırdır, public kaynaklara eklemeyin
# =============================================================================

# ─── App ────────────────────────────────────────────────────────────────────
APP_NAME=PentestAI
VERSION=1.0.0
DEBUG=False                              # Production'da KESİNLİKLE False yapın!
ENV=production                         # development | staging | production
LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pentestai
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pentestai
DB_POOL_SIZE=10                         # Connection pool size (default: 10)
DB_MAX_OVERFLOW=20                      # Max overflow connections (default: 20)
DB_ECHO=False                           # SQL loglama (development'da True olabilir)

# ─── Redis ──────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── RabbitMQ ──────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ─── JWT Authentication ─────────────────────────────────────────────────────
JWT_ALGORITHM=HS512                      # HS256 → HS512 upgrade
JWT_SECRET_KEY=change-me-at-least-64-chars-with-digits-123-and-special-!@char    # 64+ char, 1 digit, 1 special!
JWT_ACCESS_EXPIRATION_MINUTES=30         # Access token ömrü (was 60)
JWT_REFRESH_EXPIRATION_DAYS=30           # Refresh token ömrü
JWT_ISSUER=pentestai                     # JWT iss claim
API_KEY_ROTATION_DAYS=90               # API key rotasyon süresi (gün)

# ─── Stripe ─────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                      # Production: sk_live_...
STRIPE_WEBHOOK_SECRET=                  # Production: whsec_...

# ─── SMTP ──────────────────────────────────────────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@pentestai.com

# ─── Frontend ───────────────────────────────────────────────────────────────
FRONTEND_URL=https://app.pentestai.com  # Production: https://app.pentestai.com

# ─── Encryption ──────────────────────────────────────────────────────────────
# Üretmek için: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ─── ZAP Scanner ────────────────────────────────────────────────────────────
ZAP_BASE_URL=http://localhost:8080
ZAP_API_KEY=pentestai-zap-key

# ─── AI Agent System ────────────────────────────────────────────────────────
OPENAI_API_KEY=                         # OpenAI API key'inizi girin
OPENAI_MODEL=gpt-4o                     # Model: gpt-4o | gpt-4-turbo | gpt-3.5-turbo

# ─── Neo4j ─────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password                 # Production'da güçlü bir parola kullanın!

# ─── Observability ──────────────────────────────────────────────────────────
OTEL_ENDPOINT=                          # OpenTelemetry Collector endpoint (orn: http://otel-collector:4317)
OTEL_TOKEN=                             # OpenTelemetry auth token (varsa)
SENTRY_DSN=                             # Sentry DSN — https://key@oxxx.ingest.sentry.io/project
