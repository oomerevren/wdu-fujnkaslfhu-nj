# PentestAI Production Environment
ENV=production
DEBUG=False
APP_NAME=PentestAI
VERSION=1.0.0
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pentestai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600
DB_ECHO=False
DB_POOL_USE_LIFO=True

# Async Database (derived from DATABASE_URL by config, but can be set explicitly)
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pentestai

# Redis
REDIS_URL=redis://localhost:6379/0

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# JWT Authentication — CRITICAL: At least 64 chars, 1 digit, 1 special char
JWT_ALGORITHM=HS512
JWT_SECRET_KEY=PentestAI_Secret_Key_2026!@#Secure_64_Chars_With_Digits_1234567890!@#
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_ISSUER=pentestai
API_KEY_ROTATION_DAYS=90

# Stripe — Production keys (set via secure env management, NOT committed)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP — Production SMTP credentials (set via secure env management)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=noreply@pentestai.com

# Frontend
FRONTEND_URL=https://app.pentestai.com

# Encryption — Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ZAP Scanner
ZAP_BASE_URL=http://localhost:8080
ZAP_API_KEY=pentestai-zap-key

# AI Agent System — Set production OpenAI key securely
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Neo4j — Production credentials
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pentestai-neo4j-secret

# Observability
OTEL_ENDPOINT=
OTEL_TOKEN=
SENTRY_DSN=

# CORS — Production origins
CORS_ORIGINS=http://localhost:3000,https://app.pentestai.com
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_HEADERS=Authorization,Content-Type,X-Request-ID,Idempotency-Key
CORS_EXPOSE_HEADERS=X-Request-ID,X-RateLimit-Limit,X-RateLimit-Remaining,X-RateLimit-Reset

# Security
RATE_LIMIT_AUTH=5/min
RATE_LIMIT_API=30/sec
